[Unit]
Description=Mirae robot runtime
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=mirae
Group=mirae
SupplementaryGroups=gpio i2c video audio
WorkingDirectory=/opt/mirae
Environment=MIRAE_CONFIG=/etc/mirae/mirae.toml
ExecStart=/opt/mirae/.venv/bin/mirae --profile pi run
Restart=on-failure
RestartSec=2
# Stop quickly so the motors are released; the runtime stops them on SIGTERM.
TimeoutStopSec=5

[Install]
WantedBy=multi-user.target
