# ---------------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
/build/
/dist/

# Virtual environments (uv creates .venv/)
.venv/
venv/

# Tooling caches and reports
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# ---------------------------------------------------------------------------
# Robot runtime data
# ---------------------------------------------------------------------------
# Model weights are downloaded at runtime, not committed
/models/
# Recordings, logs, snapshots
/var/
*.log

# Local config and secrets (API keys for remote AI providers)
mirae.local.toml
.env
.env.*
!.env.example

# ---------------------------------------------------------------------------
# CAD
# ---------------------------------------------------------------------------
# Private authoring sources and tooling. Git contains printable exports and
# production website assets; these inputs stay on the maintainer's machine.
cad/blender/
cad/low-poly/
cad/reference/
cad/renders/assets/
cad/renders/marketing/
site/build_media.py
site/optimize_glb.py
assets/brand/favicon-16.png
assets/brand/favicon.ico

# Local render caches. Only final website media and the documentation preview
# belong in Git; production media credits are in assets/CREDITS.md.
cad/renders/web/
cad/renders/assembly/
cad/renders/assembly-web/
cad/renders/previews/
cad/renders/wiring/
cad/renders/mirae_*.png

# Simulator authoring masters (house.blend, full-quality GLB). The site's
# optimized exports live in site/public/media/house/ and are tracked there.
/sim/

# Blender autosave/backup copies
*.blend[0-9]
*.blend[0-9][0-9]
*.blend@

# ---------------------------------------------------------------------------
# Editors and IDEs
# ---------------------------------------------------------------------------
# JetBrains (PyCharm/IDEA): per-user workspace state
.idea/
*.iml
# VS Code: keep shared settings/extensions, ignore the rest
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.code-workspace

# ---------------------------------------------------------------------------
# Operating systems
# ---------------------------------------------------------------------------
# macOS
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk
# Editor swap/backup files
*~
*.swp
*.swo
